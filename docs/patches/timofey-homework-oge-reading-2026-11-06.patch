index fbe77c2..6dee8a4 100644
--- a/timofey-homework/app.css
+++ b/timofey-homework/app.css
@@ -42,3 +42,32 @@
 .split .opts.many .opt{min-width:0;padding:6px 10px;font-size:16px;flex:none;white-space:normal;text-align:left;line-height:1.25}
 .q:has(.many){gap:10px}

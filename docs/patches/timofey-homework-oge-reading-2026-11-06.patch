+
+/* ---------- ОГЭ Reading: два текста, 16 вопросов ---------- */
+.ogebar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex:0 0 auto}
+.ogetabs{display:flex;gap:8px;flex-wrap:wrap;flex:1;min-width:0}
+.ogetabs .tab{display:flex;flex-direction:column;align-items:flex-start;gap:1px;padding:5px 12px;text-align:left;

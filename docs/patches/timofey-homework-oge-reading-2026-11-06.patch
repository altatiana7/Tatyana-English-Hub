+.rqt{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
+.rqt p{font-size:16px;line-height:1.3}
+.rbtn{padding:3px 10px;font-size:14px;font-weight:700;min-width:0}
+.rbtn.sel{background:var(--accent);border-color:var(--accent);color:#fff}
+.rbtn.ok{background:var(--okbg);border-color:#8fbfa5;color:#1e5c43}
+.rbtn.ok::after{content:" \2713"}
